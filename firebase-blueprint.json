{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "Registered customer profile storing phone number, name, and preferred search region.",
      "type": "object",
      "properties": {
        "userId": {
          "type": "string",
          "description": "Firebase Auth UID matching the document ID."
        },
        "fullName": {
          "type": "string",
          "description": "Customer display name."
        },
        "phoneNumber": {
          "type": "string",
          "description": "Customer phone number entered during registration."
        },
        "preferredRegion": {
          "type": "string",
          "enum": ["all", "melitopol", "kherson", "zaporizhzhia"],
          "description": "Default selected region filter."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp when profile was created."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp when profile was updated."
        }
      },
      "required": ["userId", "fullName", "phoneNumber", "preferredRegion", "createdAt", "updatedAt"]
    },
    "FavoriteApartment": {
      "title": "FavoriteApartment",
      "description": "Saved apartment bookmark owned by a user.",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "apartmentId": { "type": "string" },
        "apartmentTitle": { "type": "string" },
        "region": { "type": "string" },
        "dealType": { "type": "string", "enum": ["rent", "sale"] },
        "priceRub": { "type": "integer" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "apartmentId", "apartmentTitle", "region", "dealType", "priceRub", "createdAt", "updatedAt"]
    },
    "PaymentBooking": {
      "title": "PaymentBooking",
      "description": "Apartment booking and YooMoney anti-fraud payment verification record owned by a user.",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "apartmentId": { "type": "string" },
        "apartmentTitle": { "type": "string" },
        "dealType": { "type": "string", "enum": ["rent", "sale"] },
        "amountRub": { "type": "integer" },
        "yoomoneyWallet": { "type": "string" },
        "paymentLabel": {
          "type": "string",
          "description": "Unique immutable order label passed to YooMoney Quickpay to bind payment to this booking."
        },
        "paymentMethod": {
          "type": "string",
          "enum": ["AC", "PC"],
          "description": "AC = bank card, PC = YooMoney wallet."
        },
        "status": {
          "type": "string",
          "enum": ["awaiting_payment", "pending_verification", "verified_paid", "verification_failed", "cancelled"]
        },
        "comment": { "type": "string" },
        "submittedOperationId": { "type": "string" },
        "yoomoneyOperationId": { "type": "string" },
        "verifiedAmountRub": { "type": "integer" },
        "verificationNote": { "type": "string" },
        "verificationAttempts": { "type": "integer" },
        "checkoutOpenedAt": { "type": "string", "format": "date-time" },
        "verifiedAt": { "type": "string", "format": "date-time" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": [
        "userId",
        "apartmentId",
        "apartmentTitle",
        "dealType",
        "amountRub",
        "yoomoneyWallet",
        "paymentLabel",
        "paymentMethod",
        "status",
        "verificationAttempts",
        "createdAt",
        "updatedAt"
      ]
    },
    "UsedYooMoneyOperation": {
      "title": "UsedYooMoneyOperation",
      "description": "Immutable anti-replay ledger preventing one YooMoney operation_id from confirming multiple bookings.",
      "type": "object",
      "properties": {
        "operationId": { "type": "string" },
        "bookingId": { "type": "string" },
        "claimedByUid": { "type": "string" },
        "amountRub": { "type": "integer" },
        "wallet": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["operationId", "bookingId", "claimedByUid", "amountRub", "wallet", "createdAt"]
    },
    "KnowledgeArticle": {
      "title": "KnowledgeArticle",
      "description": "Company knowledge base article powering the YugDom API Consultant.",
      "type": "object",
      "properties": {
        "articleId": { "type": "string" },
        "category": { "type": "string" },
        "title": { "type": "string" },
        "summary": { "type": "string" },
        "keywords": { "type": "array", "items": { "type": "string" } },
        "priority": { "type": "integer" }
      },
      "required": ["articleId", "category", "title", "summary", "keywords", "priority"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/UserProfile" },
      "description": "Private customer registration profile isolated by userId."
    },
    "/users/{userId}/favorites/{favoriteId}": {
      "schema": { "$ref": "#/entities/FavoriteApartment" },
      "description": "Customer's saved favorite apartments."
    },
    "/users/{userId}/bookings/{bookingId}": {
      "schema": { "$ref": "#/entities/PaymentBooking" },
      "description": "Customer's apartment bookings with YooMoney anti-fraud verification state."
    },
    "/used_operations/{operationId}": {
      "schema": { "$ref": "#/entities/UsedYooMoneyOperation" },
      "description": "Write-once anti-replay ledger for verified YooMoney operation IDs."
    },
    "/consultant_kb/{articleId}": {
      "schema": { "$ref": "#/entities/KnowledgeArticle" },
      "description": "Read-only company knowledge base articles for the YugDom Consultant API."
    }
  }
}
