# YOOMONEY_CLIENT_ID: OAuth2 client_id приложения ЮMoney (добавьте значение в панель Secrets в AI Studio).
YOOMONEY_CLIENT_ID=YOUR_YOOMONEY_CLIENT_ID
# YOOMONEY_CLIENT_SECRET: OAuth2 client_secret приложения ЮMoney (добавьте значение в панель Secrets в AI Studio).
YOOMONEY_CLIENT_SECRET=YOUR_YOOMONEY_CLIENT_SECRET
